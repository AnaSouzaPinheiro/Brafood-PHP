<IfModule mod_rewrite.c>
  RewriteEngine On

  # Se a requisição for para PHP, deixa passar
  RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
  RewriteRule ^ - [L]

  # Se o arquivo ou pasta existe, deixa passar
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Senão, serve index.html (Angular Router)
  RewriteRule ^ index.html [L]
</IfModule>
