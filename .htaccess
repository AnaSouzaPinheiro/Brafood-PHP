RewriteEngine On

# Bloqueia acesso público a arquivos sensíveis (.env, composer, logs...)
<FilesMatch "^(\.env.*|composer\.(json|lock)|phpunit\.xml|.*\.log)$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/(.*/)?(vendor|logs|tests|cache|\.git)(/|$)

# Hospedagens com PHP via CGI/FastCGI descartam o header Authorization
# por padrão. Repassa para o PHP conseguir ler.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Uploads são só imagens: nunca devolve nem executa scripts dessa pasta
RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$ - [F,L]

# Responde preflight OPTIONS direto, sem passar pelo PHP
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# CORS: libera apenas as origens conhecidas (prod e dev local)
<IfModule mod_headers.c>
    # O cors.php também envia esses headers; remove os do PHP para não
    # duplicar (o navegador rejeita Access-Control-Allow-Origin repetido)
    Header unset Access-Control-Allow-Origin
    Header unset Access-Control-Allow-Methods
    Header unset Access-Control-Allow-Headers
    Header unset Access-Control-Allow-Credentials

    SetEnvIf Origin "^(https://brafood\.page\.gd|http://localhost:4200)$" CORS_ORIGIN=$1
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-User-Id"
    Header always set Access-Control-Allow-Credentials "true"

    # Cabeçalhos de segurança
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Miniatura de card ainda não gerada → thumb.php cria, salva e serve
RewriteRule ^uploads/receitas/thumbs/([A-Za-z0-9_.-]+)\.webp$ thumb.php?f=$1 [L]

RewriteRule ^ index.php [L]

# Uploads têm nome único (uniqid), então o navegador pode guardar por 1 ano
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
