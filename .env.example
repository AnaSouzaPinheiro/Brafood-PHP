# Copie este arquivo para .env e preencha os valores

APP_ENV=development
APP_URL=http://localhost

# Banco de dados
DB_HOST=localhost
DB_NAME=brafood
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# CORS — em dev pode deixar * ou http://localhost:5173
ALLOWED_ORIGIN=*

# SMTP
MAIL_USER=seuemail@gmail.com
MAIL_PASS=sua_senha_de_app

# OpenRouter / IA
OPENROUTER_API_KEY=sua_chave_aqui
