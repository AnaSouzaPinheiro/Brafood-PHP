# Copie para .env e preencha. Em produção o .env é gerado pelo GitHub Actions
# a partir dos Secrets (ver .github/workflows/deploy.yml).

APP_ENV=development
APP_URL=http://localhost:4200

# Banco de dados
DB_HOST=localhost
DB_NAME=brafood_php
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# CORS
ALLOWED_ORIGIN=http://localhost:4200

# SMTP (Gmail - senha de app)
MAIL_USER=seuemail@gmail.com
MAIL_PASS=sua_senha_de_app

# OpenRouter / IA
OPENROUTER_API_KEY=sua_chave_aqui
